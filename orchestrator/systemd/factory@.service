[Unit]
Description=factory lane %i: one unit of work (shepherd one PR, or one issue end to end)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Which repository, and how (deploy/orchestrator-install.sh creates it from instances/factory.env.example).
EnvironmentFile=/etc/factory/instance.env
# Sandboxes are transient units that outlive a killed run.sh (systemd-run --wait does not stop
# them when its client dies), so every start and every end of a lane stops the lane's slice.
ExecStartPre=-/usr/bin/systemctl stop factory-s%i.slice
ExecStart=/opt/factory/run.sh --slot %i
ExecStopPost=/opt/factory/run.sh --cleanup %i
# Worst case: 3 agent rounds x 300 min (AGENT_TIMEOUT) + 3 verify rounds x 60 min, plus a wait
# for the merge lock.
TimeoutStartSec=20h
TimeoutStopSec=60
