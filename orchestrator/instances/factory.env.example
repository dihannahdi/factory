# The first factory instance on this machine. deploy/orchestrator-install.sh copies this file to
# /etc/factory/instance.env on its first run and stops so you can edit it; the lanes and the sync
# read it through systemd (EnvironmentFile=), so plain KEY=VALUE lines, no shell, no quotes needed
# except around values with spaces. Re-run the installer after editing.
#
# Only REPO is required. Everything else has a safe default; the lines below show what you are most
# likely to change. A second repository on the same machine is a second instance:
# see orchestrator/instances/blog.env and deploy/instance-install.sh.

# --- the repository ------------------------------------------------------------------------------
# owner/name. The token in /etc/factory/gh-token should be fine-grained, for this repository only:
# Contents, Pull requests, Issues and Actions read and write, Checks read (docs/self-hosting.md).
REPO=

# --- what the agent may do -----------------------------------------------------------------------
# pr (default): open the PR, wait for green CI and the agent's own review, label it agent-ready,
# and stop. A human merges. auto: merge it too, then watch the deploy and HEALTH_URL.
MERGE_MODE=pr
# Only with MERGE_MODE=auto: a URL that answers 200 when the deployed site is healthy. Empty: no
# deploy watch.
HEALTH_URL=

# --- how to verify a change ---------------------------------------------------------------------
# node: at the repo root, npm ci, then the `check` and `test` scripts if package.json has them,
#   the build, and the Playwright suite when there is an `e2e` script.
# cargo: an executable scripts/verify-extra.sh first if your repo has one, then cargo build and
#   cargo test for the workspace, plus npm ci, build and an `test:e2e` run in frontend/ when a
#   change touches it.
VERIFY_KIND=node
# Where new SQL migrations go; the agent may add files there but never edit existing ones.
MIGRATIONS_DIR=migrations
# The env var your tests read a Postgres URL from. Set it and every lane gets its own throwaway
# Postgres; leave it empty and none is started.
PG_TEST_ENV=

# --- sandbox -------------------------------------------------------------------------------------
# This machine's own public IP(s), space-separated. The sandbox can reach the internet but never
# these, so the agent cannot talk to other services on this box through the public interface.
SB_DENY_EXTRA=

# --- models and money ----------------------------------------------------------------------------
# Default: OpenCode Zen's free models only, $0. To add OpenCode Go ($10/month, opencode.ai/go):
#   1. put the key in /etc/opencode/go.key, owner root, group factory, mode 0640
#   2. remove the two empty lines below (or list the Go models you want in GO_MODELS)
#   3. set the budgets at or under the limits your plan shows; when one is reached the Go models
#      rest until that window resets, and a charge factory did not expect halts every lane.
GO_MODELS=
GO_ACCOUNTS=
# GO_BUDGET_5H=
# GO_BUDGET_WEEK=
# GO_BUDGET_MONTH=
