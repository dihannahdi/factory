# Example of a second instance ("blog": another repo on the same box): the same /opt/factory code
# as the first instance, configured only by this file. Installed as /etc/blog-agent/instance.env
# (deploy/instance-install.sh) and read by systemd (EnvironmentFile=), so plain KEY=VALUE lines, no
# shell. An empty value is meant where it is empty: the code treats "unset" and "empty" differently
# for the ones marked [empty].

# --- which repo, and where this instance keeps its own state (nothing is shared with the first) ---
REPO=acme/blog
STATE=/var/lib/blog-agent
UI=/var/lib/blog-ops/ui
CTL=/var/lib/blog-ops/ctl
LOGDIR=/var/log/blog-agent
# Created by the first sync (git clone --bare, token from GH_TOKEN_FILE); the first instance's is mirror.git.
MIRROR=/opt/factory/mirror-blog.git
# A token with access to REPO only. Root-only; the sandbox cannot see /etc/blog-agent.
GH_TOKEN_FILE=/etc/blog-agent/gh-token
# Checked after each deploy when MERGE_MODE=auto. Leave it out (or empty) for no deploy watch.
HEALTH_URL=https://blog.example.com/api/health

# --- lanes: slots 4 and 5 of the shared sandbox user (the first instance keeps 1-3, 9 is the gates') -
SLOTS="4 5"
# The systemd template of the lanes: blog-agent@4.service. A claim proves its lane is alive through it.
AGENT_UNIT=blog-agent

# --- what this repo is --------------------------------------------------------------------------------
VERIFY_KIND=node
MIGRATIONS_DIR=db/migrations
# [empty] No database tests: no per-lane Postgres is started.
PG_TEST_ENV=
# Playwright (when the repo has an e2e script) fails a PR's CI like any other check.
PLAYWRIGHT_GATE=1

# --- spending: free models only ------------------------------------------------------------------------
# [empty] No paid (OpenCode Go) model is offered, and no Go account is used.
GO_MODELS=
GO_ACCOUNTS=
GO_BUDGET_5H=0
GO_BUDGET_WEEK=0
GO_BUDGET_MONTH=0
# Key paths point at files that do not exist, so no Go key can be handed to this instance by accident.
GO_KEY_FILE=/etc/blog-agent/no-go.key
GO2_KEY_FILE=/etc/blog-agent/no-go2.key
# [empty] No extra credential reaches this instance's model turns.
AGENT_CRED=
# /etc/opencode/opencode.json is one file for every instance (same sandbox user); the first instance's sync owns it.
WHITELIST_WRITE=0
