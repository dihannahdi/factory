{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "enabled_providers": [
    "opencode"
  ],
  "provider": {
    "opencode": {
      "whitelist": [
        "deepseek-v4.1-flash-free"
      ]
    }
  },
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "instructions": [
    "CONTEXT.md"
  ],
  "agent": {
    "build": {
      "steps": 250
    }
  },
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "sudo *": "deny",
      "pkill *": "deny",
      "killall *": "deny"
    }
  }
}
