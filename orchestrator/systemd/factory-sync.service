[Unit]
Description=factory sync: GitHub and model state for the console, whitelist, unblock, claims
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Which repository, and how (deploy/orchestrator-install.sh creates it from instances/factory.env.example).
EnvironmentFile=/etc/factory/instance.env
ExecStart=/opt/factory/sync.sh
# Must finish inside one timer period; sync.sh gives every step its own timeout.
TimeoutStartSec=55
