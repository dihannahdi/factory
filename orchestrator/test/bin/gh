#!/usr/bin/env bash
# Test stub for the GitHub CLI: answers from FAKE_GH_DIR/*.json.
d=${FAKE_GH_DIR:-/nonexistent}
case "$1 $2" in
  "issue list")
    if [[ " $* " == *" --state closed "* ]]; then cat "$d/closed.json" 2>/dev/null || echo '[]'; else cat "$d/issues.json"; fi ;;
  "pr list") cat "$d/prs.json" ;;
  "run list") echo '{"sha":"1111111111111111111111111111111111111111","status":"completed","conclusion":"success","url":"https://example.invalid/run/1"}' ;;
  "api repos/"*) echo 0 ;;
  *) ;;
esac
exit 0
